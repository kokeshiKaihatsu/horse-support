---
layout: layouts/base.njk
title: 活動タイムライン
permalink: "/timeline/index.html"
---

<h1>🐴 活動タイムライン</h1>

{% block styles %}
  <link rel="stylesheet" href="/styles/timeline.css">
{% endblock %}

{% for post in collections.posts | sort(true) %}
  <article class="timeline-item"
           data-file="{{ post.inputPath }}">

    <button class="delete-post-btn edit-btn"
            data-file="{{ post.inputPath }}"
            style="display:none;">
      🗑️
    </button>

    <h2>{{ post.data.title }}</h2>

    <p class="date">{{ post.date | date("yyyy/MM/dd") }}</p>

    <div class="timeline-images">
      {% if post.data.images %}
        {% for img in post.data.images %}
         <img src="{{ img.image }}" alt="{{ post.data.title }}" class="timeline-img">
        {% endfor %}
      {% endif %}
    </div>

    <div class="body">
      {{ post.templateContent | safe }}
    </div>
  </article>
{% endfor %}

<div id="imgModal" class="modal">
  <span class="close">&times;</span>
  <img class="modal-content" id="modalImg">
</div>

<script src="/scripts/admin.js"></script>
