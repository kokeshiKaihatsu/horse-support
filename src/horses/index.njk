---
layout: layouts/base.njk
title: 馬一覧
---
{% block styles %}
<link rel="stylesheet" href="/styles/horses.css">
{% endblock %}

<h2>養老馬一覧</h2>

<div class="horse-list">
  {% for horse in collections.horses %}
    <div class="horse-card" data-id="{{ horse.data.id }}">

      <!-- 編集ボタン（インライン編集用） -->
      <button class="edit-btn" style="display:none;">✏️</button>

      <!-- 通常表示 -->
      <div class="view-mode">
        <h3>{{ horse.data.name }}</h3>
        <img src="{{ horse.data.image }}" alt="{{ horse.data.name }}">
        <div class="horse-info">
          <p><strong>誕生日　：</strong> {{ horse.data.birthday }}</p>
          <p><strong>年齢　　：</strong> {{ horse.data.birthday | calcAge }}</p>
          <p><strong>特徴　　：</strong> {{ horse.data.description }}</p>
        </div>
      </div>
     <!-- 編集モード（最初は非表示） -->
      <div class="edit-mode" style="display:none;">
        <label>名前</label>
        <input type="text" class="edit-name" value="{{ horse.data.name }}">

        <label>画像</label>
        <input type="file" class="edit-image-file" accept="image/*">

        <label>誕生日</label>
        <input type="text" class="edit-birthday" value="{{ horse.data.birthday }}">

        <label>特徴</label>
        <textarea class="edit-desc">{{ horse.data.description }}</textarea>

        <button class="save-btn">保存</button>
        <button class="cancel-btn">キャンセル</button>
      </div>
    </div>
  {% endfor %}
</div>

<script src="/scripts/admin.js"></script>
