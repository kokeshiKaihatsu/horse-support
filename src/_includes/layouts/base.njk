<!DOCTYPE html>
<html lang="ja">
<link href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@400;700&display=swap" rel="stylesheet">

<head>
  <meta charset="UTF-8">
  <title>{{ title }}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- 共通CSS -->
  <link rel="stylesheet" href="/styles.css">

  <!-- ページごとのCSSを読み込む -->
  {% block styles %}{% endblock %}
</head>
  <body>

    <header class="site-header">
      <div class="logo">
        <a href="/">ホームに戻る</a>

        <a
          href="/admin/"
          class="admin-link"
          id="adminLink"
          style="display:none;"
        >
          管理
        </a>
      </div>

      <nav class="nav-right">
        <a href="/login/" class="login-btn" id="userBtn">
          ログイン
        </a>
      </nav>
    </header>

    <main>
      {{ content | safe }}
    </main>

    <footer>
      <p>ひめちゃんの支援クラブ</p>
    </footer>

  </body>
</html>
