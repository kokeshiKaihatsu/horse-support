<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>{{ title }}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- 共通CSS -->
  <link rel="stylesheet" href="/styles.css">

  <!-- ページごとのCSSを読み込む -->
  {% block styles %}{% endblock %}
</head>
<body>

  <header class="site-header">
    <div class="logo">
      <a href="/">こけし牧場</a>

      {# 管理者リンク（今は常に表示） #}
      <a href="/admin/" class="admin-link">管理</a>
    </div>

    <nav class="nav-right">
      {% if user %}
        <span class="user-name">{{ user.name }} さん</span>
      {% else %}
        <a href="/login/" class="login-btn">ログイン</a>
      {% endif %}
    </nav>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer>
    <p>ひめちゃんの支援クラブ</p>
  </footer>

</body>
</html>
