---
layout: layouts/base.njk
title: 馬の追加
permalink: "/admin/horses/index.html"
---

{% block styles %}
  <link rel="stylesheet" href="/styles/admin.css">
{% endblock %}

<h1>🐴 馬の追加</h1>

<form id="addHorseForm" class="admin-form">
  <label>馬ID（英字）</label>
  <input type="text" id="horseId" required>

  <label>名前</label>
  <input type="text" id="horseName" required>

  <label>画像</label>
  <input type="file" id="horseImage" accept="image/*">

  <div id="imagePreview" class="image-preview"></div>

  <label>説明</label>
  <textarea id="horseDesc"></textarea>

  <button type="submit" class="submit-btn">追加する</button>
</form>

<script src="/scripts/admin.js"></script>
